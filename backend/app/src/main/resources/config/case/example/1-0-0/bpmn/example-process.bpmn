  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="example-participant" name="Example Process" processRef="example-process" />
  </bpmn:collaboration>
  <bpmn:process id="example-process" name="Example Process" isExecutable="true">
    <bpmn:startEvent id="start-event" name="Process started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start-event" targetRef="WaitTask" />
    <bpmn:sequenceFlow id="Flow_0nqmpq1" sourceRef="WaitForDocument" targetRef="ConfirmReceivedDocument" />
    <bpmn:sequenceFlow id="Flow_1qd1ud5" sourceRef="ConfirmReceivedDocument" targetRef="end-event" />
    <bpmn:endEvent id="end-event" name="Process ended">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1qd1ud5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ConfirmReceivedDocument" name="Confirm received document">
      <bpmn:incoming>Flow_0nqmpq1</bpmn:incoming>
      <bpmn:outgoing>Flow_1qd1ud5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="WaitForDocument" name="Waiting for document added to case">
      <bpmn:incoming>Flow_1m2k9xh</bpmn:incoming>
      <bpmn:outgoing>Flow_0nqmpq1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0fgda1t" messageRef="Message_18jg0tj" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_1m2k9xh" sourceRef="WaitTask" targetRef="WaitForDocument" />
    <bpmn:userTask id="WaitTask" name="check">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_1m2k9xh</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmn:message id="Message_18jg0tj" name="DOCUMENT_RECEIVED" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
