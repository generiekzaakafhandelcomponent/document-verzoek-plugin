<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.23.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="example-participant" name="Example Process" processRef="example-process" />
  </bpmn:collaboration>
  <bpmn:process id="example-process" name="Example Process" isExecutable="true">
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start-event" targetRef="Gateway_01o5cq4" />
    <bpmn:sequenceFlow id="Flow_0nqmpq1" sourceRef="WaitForDocument" targetRef="ConfirmReceivedDocument" />
    <bpmn:sequenceFlow id="Flow_1qd1ud5" sourceRef="ConfirmReceivedDocument" targetRef="Gateway_0771du8" />
    <bpmn:userTask id="ConfirmReceivedDocument" name="Confirm received document">
      <bpmn:incoming>Flow_0nqmpq1</bpmn:incoming>
      <bpmn:outgoing>Flow_1qd1ud5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="WaitForDocument" name="Waiting for document added to case">
      <bpmn:incoming>Flow_0w23zrd</bpmn:incoming>
      <bpmn:outgoing>Flow_0nqmpq1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0fgda1t" messageRef="Message_18jg0tj" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_01o5cq4" default="Flow_0w23zrd">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_0w23zrd</bpmn:outgoing>
      <bpmn:outgoing>Flow_0qc59cu</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0w23zrd" sourceRef="Gateway_01o5cq4" targetRef="WaitForDocument" />
    <bpmn:sequenceFlow id="Flow_1feltyr" sourceRef="Gateway_0771du8" targetRef="end-event" />
    <bpmn:sequenceFlow id="Flow_0qc59cu" sourceRef="Gateway_01o5cq4" targetRef="test-met-bouwblok-task">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.hasVariable("test-flow") &amp;&amp; execution.getVariable("test-flow") == "MET_BOUWBLOK" }</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:callActivity id="test-met-bouwblok-task" name="Test met bouwblok" calledElement="external-document-notification-proces" camunda:calledElementBinding="versionTag" camunda:calledElementVersionTag="BB:external-document-notification:1.0.0">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{buildingBlockDocumentId}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0qc59cu</bpmn:incoming>
      <bpmn:outgoing>Flow_01ze8tm</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_01ze8tm" sourceRef="test-met-bouwblok-task" targetRef="Gateway_0771du8" />
    <bpmn:endEvent id="end-event" name="Process ended">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1feltyr</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_0771du8">
      <bpmn:incoming>Flow_1qd1ud5</bpmn:incoming>
      <bpmn:incoming>Flow_01ze8tm</bpmn:incoming>
      <bpmn:outgoing>Flow_1feltyr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="start-event" name="Process started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:message id="Message_18jg0tj" name="DOCUMENT_RECEIVED" />
